---
import type { Lang } from "@/i18n/config";
import { getPath } from "@/i18n/routes";
import { getDictionary, useTranslations } from "@/i18n/utils";
import { interests } from "@/data/site";
import { getFeaturedProjects } from "@/lib/projects";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import CaseStudyRow from "@/components/CaseStudyRow.astro";
import HeroSection from "@/components/HeroSection.astro";
import Icon from "@/components/Icon.astro";
import Marquee from "@/components/Marquee.astro";
import StatRow from "@/components/StatRow.astro";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const dict = getDictionary(lang);
const featured = (await getFeaturedProjects()).slice(0, 3);
---

<BaseLayout lang={lang} routeId="home" description={t("meta.home.description")}>
    <HeroSection
        size="full"
        eyebrow={t("home.eyebrow")}
        title={t("home.heroTitle")}
        accent={t("home.heroAccent")}
        lead={t("home.lead")}
    >
        <div class="mt-9 flex flex-wrap items-center gap-3">
            <Button href={getPath("projects", lang)}>
                {t("home.ctaWork")}
                <Icon name="arrow-right" class="size-4" />
            </Button>
            <Button href={getPath("services", lang)} variant="secondary">
                {t("home.ctaHire")}
            </Button>
        </div>
        <p class="mt-10 flex items-center gap-2 font-mono text-xs tracking-[0.14em] text-ink-muted uppercase">
            <Icon name="map-pin" class="size-4 text-accent" />
            {t("home.location")}
        </p>
    </HeroSection>

    <Marquee
        items={interests.map((key) => t(`interests.${key}`))}
        label={t("home.interestsLabel")}
    />

    <section class="container-page pt-24 sm:pt-32" aria-labelledby="selected-heading">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
            <div class="max-w-2xl">
                <p class="section-label">01 / {t("home.selectedTitle")}</p>
                <h2 id="selected-heading" class="mt-4 text-4xl sm:text-5xl">
                    {t("home.selectedTitle")}
                </h2>
                <p class="mt-4 text-lg leading-relaxed text-ink-muted">{t("home.selectedLead")}</p>
            </div>
            <a
                href={getPath("projects", lang)}
                class="link inline-flex shrink-0 items-center gap-1.5"
            >
                {t("home.viewAllProjects")}
                <Icon name="arrow-right" class="size-4" />
            </a>
        </div>
        <div class="mt-10">
            {featured.map((project, index) => (
                <CaseStudyRow
                    project={project}
                    lang={lang}
                    number={index + 1}
                    reverse={index % 2 === 1}
                    details={false}
                />
            ))}
        </div>
    </section>

    <div class="container-page pt-8">
        <StatRow stats={dict.home.stats} label={t("home.statsLabel")} />
    </div>

    <section class="container-page grid gap-6 pt-24 lg:grid-cols-[1.4fr_1fr]">
        <div class="border-t border-line pt-8" data-reveal>
            <p class="section-label">02 / {t("home.currentlyTitle")}</p>
            <h2 class="mt-4 text-3xl sm:text-4xl">{t("home.currentlyTitle")}</h2>
            <ul class="mt-8 divide-y divide-line">
                {dict.home.currently.map((item) => (
                    <li class="flex gap-4 py-4 leading-relaxed text-ink-muted">
                        <span
                            class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent"
                            aria-hidden="true"
                        />
                        {item}
                    </li>
                ))}
            </ul>
        </div>
        <div
            class="surface-dark relative isolate flex flex-col justify-between gap-10 overflow-hidden rounded-3xl bg-bg p-8 sm:p-10"
            data-reveal
            style="--reveal-delay: 120ms"
        >
            <div
                class="absolute inset-0 -z-10 bg-[radial-gradient(90%_90%_at_100%_0%,rgba(79,209,193,0.22),transparent_60%)]"
                aria-hidden="true"
            ></div>
            <div>
                <p class="section-label">03 / {t("nav.services")}</p>
                <h2 class="mt-4 text-3xl sm:text-4xl">{t("home.servicesTitle")}</h2>
                <p class="mt-4 leading-relaxed text-ink-muted">{t("home.servicesBody")}</p>
            </div>
            <Button href={getPath("services", lang)} class="self-start">
                {t("home.servicesCta")}
                <Icon name="arrow-right" class="size-4" />
            </Button>
        </div>
    </section>
</BaseLayout>
