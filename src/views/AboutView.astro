---
import type { Lang } from "@/i18n/config";
import { getPath } from "@/i18n/routes";
import { getDictionary, useTranslations } from "@/i18n/utils";
import { site, tools } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import HeroSection from "@/components/HeroSection.astro";
import Icon from "@/components/Icon.astro";
import TagList from "@/components/TagList.astro";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const dict = getDictionary(lang);
const toolGroups = Object.keys(tools) as (keyof typeof tools)[];
---

<BaseLayout
    lang={lang}
    routeId="about"
    title={t("meta.about.title")}
    description={t("meta.about.description")}
>
    <HeroSection
        eyebrow={t("about.eyebrow")}
        title={t("about.title")}
        accent={t("about.titleAccent")}
    >
        <div class="mt-9 flex flex-wrap items-center gap-3">
            <Button href={site.resume}>
                <Icon name="file" class="size-4" />
                {t("about.resumeCta")}
            </Button>
            <Button href={getPath("contact", lang)} variant="secondary">
                {t("about.contactCta")}
            </Button>
        </div>
    </HeroSection>

    <section class="container-page grid gap-10 pt-20 lg:grid-cols-12">
        <div class="lg:col-span-4" data-reveal>
            <p class="section-label">01 / {t("about.eyebrow")}</p>
            <p class="mt-6 flex items-start gap-2 font-mono text-xs leading-relaxed tracking-[0.12em] text-ink-muted uppercase">
                <Icon name="map-pin" class="size-4 shrink-0 text-accent" />
                <span>
                    <span class="sr-only">{t("about.locationTitle")}: </span>
                    {t("about.location")}
                </span>
            </p>
        </div>
        <div
            class="space-y-6 text-xl leading-relaxed text-ink lg:col-span-8 sm:text-2xl"
            data-reveal
        >
            {dict.about.intro.map((paragraph) => (
                <p>{paragraph}</p>
            ))}
        </div>
    </section>

    <section
        class="container-page grid gap-10 pt-28 lg:grid-cols-12"
        aria-labelledby="research-heading"
    >
        <div class="lg:col-span-4" data-reveal>
            <p class="section-label">02 / {t("about.researchTitle")}</p>
            <h2 id="research-heading" class="mt-4 text-4xl sm:text-5xl">
                {t("about.researchTitle")}
            </h2>
            <p class="mt-4 leading-relaxed text-ink-muted">{t("about.researchLead")}</p>
        </div>
        <ol class="border-b border-line lg:col-span-8">
            {dict.about.research.map((item, index) => (
                <li
                    class="grid gap-2 border-t border-line py-7 sm:grid-cols-[3.5rem_1fr]"
                    data-reveal
                    style={`--reveal-delay: ${index * 60}ms`}
                >
                    <span class="font-mono text-sm text-accent" aria-hidden="true">
                        {String(index + 1).padStart(2, "0")}
                    </span>
                    <div>
                        <h3 class="text-2xl">{item.title}</h3>
                        <p class="mt-2 max-w-xl leading-relaxed text-ink-muted">{item.body}</p>
                    </div>
                </li>
            ))}
        </ol>
    </section>

    <section
        class="container-page grid gap-10 pt-28 lg:grid-cols-12"
        aria-labelledby="teaching-heading"
    >
        <div class="lg:col-span-4" data-reveal>
            <p class="section-label">03 / {t("about.teachingTitle")}</p>
            <h2 id="teaching-heading" class="mt-4 text-4xl sm:text-5xl">
                {t("about.teachingTitle")}
            </h2>
        </div>
        <div class="space-y-5 text-lg leading-relaxed text-ink-muted lg:col-span-8" data-reveal>
            {dict.about.teaching.map((paragraph) => (
                <p>{paragraph}</p>
            ))}
            <p>
                <a
                    href={site.studentPortfolios}
                    class="link inline-flex items-center gap-1.5"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    {t("about.teachingLink")}
                    <span class="sr-only">{t("a11y.opensInNewTab")}</span>
                    <Icon name="arrow-up-right" class="size-4" />
                </a>
            </p>
        </div>
    </section>

    <section
        class="container-page grid gap-10 pt-28 lg:grid-cols-12"
        aria-labelledby="experience-heading"
    >
        <div class="lg:col-span-4" data-reveal>
            <p class="section-label">04 / {t("about.experienceTitle")}</p>
            <h2 id="experience-heading" class="mt-4 text-4xl sm:text-5xl">
                {t("about.experienceTitle")}
            </h2>
        </div>
        <ol class="border-b border-line lg:col-span-8">
            {dict.about.experience.map((item) => (
                <li
                    class="grid gap-3 border-t border-line py-8 sm:grid-cols-[11rem_1fr]"
                    data-reveal
                >
                    <p class="font-mono text-xs leading-relaxed tracking-[0.1em] text-ink-muted uppercase">
                        {item.dates}
                    </p>
                    <div>
                        <h3 class="font-sans text-lg font-semibold tracking-normal">{item.role}</h3>
                        <p class="text-accent">{item.org}</p>
                        {item.points.length > 0 && (
                            <ul class="mt-4 space-y-2 leading-relaxed text-ink-muted">
                                {item.points.map((point) => (
                                    <li class="flex gap-3">
                                        <span
                                            class="mt-2.5 size-1 shrink-0 rounded-full bg-accent"
                                            aria-hidden="true"
                                        />
                                        {point}
                                    </li>
                                ))}
                            </ul>
                        )}
                    </div>
                </li>
            ))}
        </ol>
    </section>

    <section
        class="container-page grid gap-10 pt-28 lg:grid-cols-12"
        aria-labelledby="education-heading"
    >
        <div class="lg:col-span-4" data-reveal>
            <p class="section-label">05 / {t("about.educationTitle")}</p>
            <h2 id="education-heading" class="mt-4 text-4xl sm:text-5xl">
                {t("about.educationTitle")}
            </h2>
        </div>
        <ol class="border-b border-line lg:col-span-8">
            {dict.about.education.map((item) => (
                <li
                    class="grid gap-3 border-t border-line py-8 sm:grid-cols-[11rem_1fr]"
                    data-reveal
                >
                    <p class="font-mono text-xs leading-relaxed tracking-[0.1em] text-ink-muted uppercase">
                        {item.dates}
                    </p>
                    <div>
                        <h3 class="font-sans text-lg font-semibold tracking-normal">
                            {item.degree}
                        </h3>
                        <p class="text-accent">{item.school}</p>
                        {item.details && (
                            <p class="mt-3 text-sm leading-relaxed text-ink-muted">
                                {item.details}
                            </p>
                        )}
                    </div>
                </li>
            ))}
        </ol>
    </section>

    <section
        class="container-page grid gap-10 pt-28 lg:grid-cols-12"
        aria-labelledby="tools-heading"
    >
        <div class="lg:col-span-4" data-reveal>
            <p class="section-label">06 / {t("about.toolsTitle")}</p>
            <h2 id="tools-heading" class="mt-4 text-4xl sm:text-5xl">
                {t("about.toolsTitle")}
            </h2>
        </div>
        <dl class="grid gap-8 sm:grid-cols-2 lg:col-span-8" data-reveal>
            {toolGroups.map((group) => (
                <div class="border-t border-line pt-5">
                    <dt class="mb-3 font-mono text-xs tracking-[0.14em] text-ink uppercase">
                        {t(`about.toolsGroups.${group}`)}
                    </dt>
                    <dd>
                        <TagList tags={tools[group]} />
                    </dd>
                </div>
            ))}
        </dl>
    </section>
</BaseLayout>
