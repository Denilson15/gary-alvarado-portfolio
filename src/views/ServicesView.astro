---
import type { Lang } from "@/i18n/config";
import { getDictionary, useTranslations } from "@/i18n/utils";
import { getProjectsByCategory } from "@/lib/projects";
import { webServices } from "@/lib/seo";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import FormField from "@/components/FormField.astro";
import Icon from "@/components/Icon.astro";
import NetlifyForm from "@/components/NetlifyForm.astro";
import CaseStudyRow from "@/components/CaseStudyRow.astro";
import HeroSection from "@/components/HeroSection.astro";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const dict = getDictionary(lang);
const clientWork = await getProjectsByCategory("client");
const structuredData = [webServices(dict, lang, Astro.site ?? new URL(Astro.url.origin))];

const typeOptions = Object.entries(dict.services.form.typeOptions).map(([value, label]) => ({
    value,
    label,
}));
const languageOptions = Object.entries(dict.services.form.languageOptions).map(
    ([value, label]) => ({ value, label }),
);
---

<BaseLayout
    lang={lang}
    routeId="services"
    title={t("meta.services.title")}
    description={t("meta.services.description")}
    structuredData={structuredData}
>
    <HeroSection
        eyebrow={t("services.eyebrow")}
        title={t("services.title")}
        accent={t("services.titleAccent")}
        lead={t("services.lead")}
    >
        <div class="mt-9 flex flex-wrap gap-3">
            <Button href="#quote">
                {t("services.ctaQuote")}
                <Icon name="arrow-right" class="size-4" />
            </Button>
            <Button href="#work" variant="secondary">
                {t("services.ctaWork")}
            </Button>
        </div>
    </HeroSection>

    <section class="container-page pt-20" aria-labelledby="offer-heading">
        <div class="max-w-2xl" data-reveal>
            <p class="section-label">01 / {t("services.offerTitle")}</p>
            <h2 id="offer-heading" class="mt-4 text-4xl sm:text-5xl">
                {t("services.offerTitle")}
            </h2>
        </div>
        <ol class="mt-12 grid border-t border-line md:grid-cols-2 lg:grid-cols-4">
            {dict.services.offers.map((offer, index) => (
                <li
                    class:list={[
                        "border-b border-line py-8 md:px-6 lg:border-b-0",
                        index > 0 && "lg:border-l",
                        index % 2 === 1 && "md:border-l",
                        index === 0 && "md:pl-0",
                    ]}
                    data-reveal
                    style={`--reveal-delay: ${index * 80}ms`}
                >
                    <span class="font-mono text-sm text-accent" aria-hidden="true">
                        {String(index + 1).padStart(2, "0")}
                    </span>
                    <h3 class="mt-4 text-2xl">{offer.title}</h3>
                    <p class="mt-3 leading-relaxed text-ink-muted">{offer.body}</p>
                </li>
            ))}
        </ol>

        <div class="mt-12 grid gap-8 border-y border-line py-10 lg:grid-cols-12" data-reveal>
            <h3 class="text-2xl lg:col-span-4">{t("services.includedTitle")}</h3>
            <ul class="grid gap-x-8 gap-y-4 sm:grid-cols-2 lg:col-span-8">
                {dict.services.included.map((item) => (
                    <li class="flex gap-3 leading-relaxed text-ink">
                        <svg
                            class="mt-1 size-5 shrink-0 text-accent"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="m5 12 5 5 9-10" />
                        </svg>
                        {item}
                    </li>
                ))}
            </ul>
        </div>
    </section>

    {clientWork.length > 0 && (
        <section id="work" class="container-page pt-24" aria-labelledby="work-heading">
            <div class="max-w-2xl" data-reveal>
                <p class="section-label">02 / {t("services.workTitle")}</p>
                <h2 id="work-heading" class="mt-4 text-4xl sm:text-5xl">
                    {t("services.workTitle")}
                </h2>
                <p class="mt-4 text-lg text-ink-muted">{t("services.workLead")}</p>
            </div>
            <div class="mt-6">
                {clientWork.map((project, index) => (
                    <CaseStudyRow
                        project={project}
                        lang={lang}
                        number={index + 1}
                        reverse={index % 2 === 1}
                    />
                ))}
            </div>
        </section>
    )}

    <section class="container-page pt-16" aria-labelledby="process-heading">
        <div class="max-w-2xl" data-reveal>
            <p class="section-label">03 / {t("services.processTitle")}</p>
            <h2 id="process-heading" class="mt-4 text-4xl sm:text-5xl">
                {t("services.processTitle")}
            </h2>
        </div>
        <ol class="relative mt-12 grid gap-10 md:grid-cols-4 md:gap-6">
            <span
                class="absolute top-[1.15rem] right-0 left-0 hidden h-px bg-line md:block"
                aria-hidden="true"
            ></span>
            {dict.services.process.map((step, index) => (
                <li class="relative" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
                    <span
                        class="relative inline-flex size-10 items-center justify-center rounded-full border border-accent bg-bg font-mono text-sm text-accent"
                        aria-hidden="true"
                    >
                        {String(index + 1).padStart(2, "0")}
                    </span>
                    <h3 class="mt-5 text-2xl">{step.title}</h3>
                    <p class="mt-2 leading-relaxed text-ink-muted">{step.body}</p>
                </li>
            ))}
        </ol>
    </section>

    <section id="quote" class="container-page pt-24" aria-labelledby="quote-heading">
        <div class="grid gap-10 rounded-[2rem] border border-line bg-surface p-6 sm:p-10 lg:grid-cols-[1fr_1.5fr] lg:p-14">
            <div>
                <p class="section-label">04 / {t("services.formTitle")}</p>
                <h2 id="quote-heading" class="mt-4 text-4xl sm:text-5xl">
                    {t("services.formTitle")}
                </h2>
                <p class="mt-4 text-lg leading-relaxed text-ink-muted">{t("services.formLead")}</p>
            </div>
            <NetlifyForm lang={lang} name="quote" submitLabel={t("services.form.submit")}>
                <div class="grid gap-5 sm:grid-cols-2">
                    <FormField
                        lang={lang}
                        form="quote"
                        name="name"
                        label={t("services.form.name")}
                        autocomplete="name"
                        required
                    />
                    <FormField
                        lang={lang}
                        form="quote"
                        name="email"
                        type="email"
                        label={t("services.form.email")}
                        autocomplete="email"
                        required
                    />
                </div>
                <FormField
                    lang={lang}
                    form="quote"
                    name="business"
                    label={t("services.form.business")}
                    autocomplete="organization"
                />
                <div class="grid gap-5 sm:grid-cols-2">
                    <FormField
                        lang={lang}
                        form="quote"
                        name="project-type"
                        type="select"
                        label={t("services.form.type")}
                        options={typeOptions}
                        required
                    />
                    <FormField
                        lang={lang}
                        form="quote"
                        name="site-language"
                        type="select"
                        label={t("services.form.language")}
                        options={languageOptions}
                    />
                </div>
                <div class="grid gap-5 sm:grid-cols-2">
                    <FormField
                        lang={lang}
                        form="quote"
                        name="current-site"
                        type="url"
                        label={t("services.form.currentSite")}
                        autocomplete="url"
                    />
                    <FormField
                        lang={lang}
                        form="quote"
                        name="timeline"
                        label={t("services.form.timeline")}
                    />
                </div>
                <FormField
                    lang={lang}
                    form="quote"
                    name="message"
                    type="textarea"
                    label={t("services.form.message")}
                    required
                />
            </NetlifyForm>
        </div>
    </section>
</BaseLayout>
