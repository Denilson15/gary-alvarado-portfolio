---
import type { Lang } from "@/i18n/config";
import { getPath } from "@/i18n/routes";
import { useTranslations } from "@/i18n/utils";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import HeroSection from "@/components/HeroSection.astro";

/** Simple centered message page, used for the form thank-you page and 404. */
interface Props {
    lang: Lang;
    kind: "thanks" | "notFound";
}

const { lang, kind } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
    lang={lang}
    routeId={kind}
    title={t(`meta.${kind}.title`)}
    description={t(`meta.${kind}.description`)}
    noindex
>
    <HeroSection
        eyebrow={kind === "notFound" ? t("notFound.eyebrow") : undefined}
        title={t(`${kind}.title`)}
        lead={t(`${kind}.body`)}
    >
        <Button href={getPath("home", lang)} class="mt-9">
            {t(`${kind}.cta`)}
        </Button>
    </HeroSection>
</BaseLayout>
