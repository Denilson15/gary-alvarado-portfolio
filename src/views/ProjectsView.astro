---
import type { Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/utils";
import { site } from "@/data/site";
import { getProjectsByCategory } from "@/lib/projects";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import CaseStudyRow from "@/components/CaseStudyRow.astro";
import HeroSection from "@/components/HeroSection.astro";
import Icon from "@/components/Icon.astro";
import ProjectIndex from "@/components/ProjectIndex.astro";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const [live, client, code, inProgress] = await Promise.all([
    getProjectsByCategory("live"),
    getProjectsByCategory("client"),
    getProjectsByCategory("code"),
    getProjectsByCategory("in-progress"),
]);
const more = [...inProgress, ...code];
---

<BaseLayout
    lang={lang}
    routeId="projects"
    title={t("meta.projects.title")}
    description={t("meta.projects.description")}
>
    <HeroSection
        eyebrow={t("projects.eyebrow")}
        title={t("projects.title")}
        accent={t("projects.titleAccent")}
        lead={t("projects.lead")}
    />

    {live.length > 0 && (
        <section class="container-page pt-20" aria-labelledby="live-heading">
            <div class="max-w-2xl" data-reveal>
                <p class="section-label">01 / {t("projects.sections.live")}</p>
                <h2 id="live-heading" class="mt-4 text-4xl sm:text-5xl">
                    {t("projects.sections.live")}
                </h2>
                <p class="mt-4 text-lg text-ink-muted">{t("projects.sections.liveLead")}</p>
            </div>
            <div class="mt-6">
                {live.map((project, index) => (
                    <CaseStudyRow
                        project={project}
                        lang={lang}
                        number={index + 1}
                        reverse={index % 2 === 1}
                        eager={index === 0}
                    />
                ))}
            </div>
        </section>
    )}

    {client.length > 0 && (
        <section class="container-page pt-16" aria-labelledby="client-heading">
            <div class="max-w-2xl" data-reveal>
                <p class="section-label">02 / {t("projects.sections.client")}</p>
                <h2 id="client-heading" class="mt-4 text-4xl sm:text-5xl">
                    {t("projects.sections.client")}
                </h2>
                <p class="mt-4 text-lg text-ink-muted">{t("projects.sections.clientLead")}</p>
            </div>
            <div class="mt-6">
                {client.map((project, index) => (
                    <CaseStudyRow
                        project={project}
                        lang={lang}
                        number={live.length + index + 1}
                        reverse={(live.length + index) % 2 === 1}
                    />
                ))}
            </div>
        </section>
    )}

    {more.length > 0 && (
        <section class="container-page pt-16" aria-labelledby="more-work-heading">
            <div class="max-w-2xl" data-reveal>
                <p class="section-label">03 / {t("projects.sections.more")}</p>
                <h2 id="more-work-heading" class="mt-4 text-4xl sm:text-5xl">
                    {t("projects.sections.more")}
                </h2>
                <p class="mt-4 text-lg text-ink-muted">{t("projects.sections.moreLead")}</p>
            </div>
            <div class="mt-10">
                <ProjectIndex projects={more} lang={lang} start={live.length + client.length + 1} />
            </div>
        </section>
    )}

    <section class="container-page pt-20" aria-labelledby="github-heading">
        <div
            class="flex flex-col items-start justify-between gap-6 border-y border-line py-10 sm:flex-row sm:items-center"
            data-reveal
        >
            <div>
                <h2 id="github-heading" class="text-3xl">
                    {t("projects.moreTitle")}
                </h2>
                <p class="mt-2 max-w-xl text-ink-muted">{t("projects.moreBody")}</p>
            </div>
            <Button
                href={`${site.github}?tab=repositories`}
                variant="secondary"
                external
                newTabLabel={t("a11y.opensInNewTab")}
            >
                <Icon name="github" class="size-4" />
                {t("projects.moreCta")}
            </Button>
        </div>
    </section>
</BaseLayout>
