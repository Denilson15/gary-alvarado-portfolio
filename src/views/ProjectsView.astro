---
import type { Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/utils";
import { site } from "@/data/site";
import { getProjectsByCategory } from "@/lib/projects";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const [live, client, code, inProgress] = await Promise.all([
    getProjectsByCategory("live"),
    getProjectsByCategory("client"),
    getProjectsByCategory("code"),
    getProjectsByCategory("in-progress"),
]);

/** The first card spans the full row, and so does a last card that would sit alone. */
function isWide(index: number, count: number): boolean {
    return index === 0 || (index === count - 1 && (count - 1) % 2 === 1);
}

const sectionTitle = "text-2xl font-medium tracking-tight sm:text-3xl";
const sectionLead = "mt-2 text-ink-muted";
---

<BaseLayout
    lang={lang}
    routeId="projects"
    title={t("meta.projects.title")}
    description={t("meta.projects.description")}
>
    <div class="container-page pt-12 sm:pt-16 lg:pt-24">
        <SectionHeading
            level={1}
            eyebrow={t("projects.eyebrow")}
            title={t("projects.title")}
            lead={t("projects.lead")}
        />
    </div>

    {live.length > 0 && (
        <section class="container-page pt-16" aria-labelledby="live-heading">
            <h2 id="live-heading" class={sectionTitle}>
                {t("projects.sections.live")}
            </h2>
            <p class={sectionLead}>{t("projects.sections.liveLead")}</p>
            <div class="mt-8 grid gap-6 lg:grid-cols-2">
                {live.map((project, index) => (
                    <ProjectCard
                        project={project}
                        lang={lang}
                        variant={isWide(index, live.length) ? "wide" : "standard"}
                        eager={index === 0}
                    />
                ))}
            </div>
        </section>
    )}

    {client.length > 0 && (
        <section class="container-page pt-20" aria-labelledby="client-heading">
            <h2 id="client-heading" class={sectionTitle}>
                {t("projects.sections.client")}
            </h2>
            <p class={sectionLead}>{t("projects.sections.clientLead")}</p>
            <div class="mt-8 grid gap-6 lg:grid-cols-2">
                {client.map((project) => (
                    <ProjectCard project={project} lang={lang} />
                ))}
            </div>
        </section>
    )}

    {code.length > 0 && (
        <section class="container-page pt-20" aria-labelledby="code-heading">
            <h2 id="code-heading" class={sectionTitle}>
                {t("projects.sections.code")}
            </h2>
            <p class={sectionLead}>{t("projects.sections.codeLead")}</p>
            <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {code.map((project) => (
                    <ProjectCard project={project} lang={lang} variant="compact" details />
                ))}
            </div>
        </section>
    )}

    {inProgress.length > 0 && (
        <section class="container-page pt-20" aria-labelledby="progress-heading">
            <h2 id="progress-heading" class={sectionTitle}>
                {t("projects.sections.inProgress")}
            </h2>
            <p class={sectionLead}>{t("projects.sections.inProgressLead")}</p>
            <div class="mt-8 grid gap-6 lg:grid-cols-2">
                {inProgress.map((project) => (
                    <ProjectCard project={project} lang={lang} variant="wide" />
                ))}
            </div>
        </section>
    )}

    <section class="container-page pt-20" aria-labelledby="more-heading">
        <div
            class="flex flex-col items-start justify-between gap-6 rounded-3xl border border-dashed border-line p-7 sm:flex-row sm:items-center sm:p-9"
            data-reveal
        >
            <div>
                <h2 id="more-heading" class="text-2xl font-medium tracking-tight">
                    {t("projects.moreTitle")}
                </h2>
                <p class="mt-2 max-w-xl text-ink-muted">{t("projects.moreBody")}</p>
            </div>
            <Button
                href={`${site.github}?tab=repositories`}
                variant="secondary"
                external
                newTabLabel={t("a11y.opensInNewTab")}
            >
                <Icon name="github" class="size-4" />
                {t("projects.moreCta")}
            </Button>
        </div>
    </section>
</BaseLayout>
