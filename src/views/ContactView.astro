---
import type { Lang } from "@/i18n/config";
import { getPath } from "@/i18n/routes";
import { getDictionary, useTranslations } from "@/i18n/utils";
import { site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FormField from "@/components/FormField.astro";
import Icon, { type IconName } from "@/components/Icon.astro";
import NetlifyForm from "@/components/NetlifyForm.astro";
import SectionHeading from "@/components/SectionHeading.astro";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const dict = getDictionary(lang);

const reasonOptions = Object.entries(dict.contact.form.reasonOptions).map(([value, label]) => ({
    value,
    label,
}));

const links: {
    icon: IconName;
    label: string;
    value: string;
    href: string;
    external?: boolean;
}[] = [
    {
        icon: "github",
        label: t("contact.githubLabel"),
        value: `@${site.githubHandle}`,
        href: site.github,
        external: true,
    },
    {
        icon: "linkedin",
        label: t("contact.linkedinLabel"),
        value: "Gary Alvarado",
        href: site.linkedin,
        external: true,
    },
    { icon: "file", label: t("contact.resumeLabel"), value: "resume.pdf", href: site.resume },
];
---

<BaseLayout
    lang={lang}
    routeId="contact"
    title={t("meta.contact.title")}
    description={t("meta.contact.description")}
>
    <div class="container-page pt-12 sm:pt-16 lg:pt-24">
        <SectionHeading
            level={1}
            eyebrow={t("contact.eyebrow")}
            title={t("contact.title")}
            lead={t("contact.lead")}
        />
    </div>

    <div class="container-page grid gap-6 pt-14 lg:grid-cols-[1.5fr_1fr]">
        <section
            class="min-w-0 rounded-[2rem] border border-line bg-surface p-6 sm:p-10"
            aria-labelledby="form-heading"
        >
            <h2 id="form-heading" class="mb-6 text-2xl font-medium tracking-tight">
                {t("contact.formTitle")}
            </h2>
            <NetlifyForm lang={lang} name="contact" submitLabel={t("contact.form.submit")}>
                <div class="grid gap-5 sm:grid-cols-2">
                    <FormField
                        lang={lang}
                        form="contact"
                        name="name"
                        label={t("contact.form.name")}
                        autocomplete="name"
                        required
                    />
                    <FormField
                        lang={lang}
                        form="contact"
                        name="email"
                        type="email"
                        label={t("contact.form.email")}
                        autocomplete="email"
                        required
                    />
                </div>
                <FormField
                    lang={lang}
                    form="contact"
                    name="reason"
                    type="select"
                    label={t("contact.form.reason")}
                    options={reasonOptions}
                />
                <FormField
                    lang={lang}
                    form="contact"
                    name="message"
                    type="textarea"
                    label={t("contact.form.message")}
                    required
                />
            </NetlifyForm>
        </section>

        <aside class="flex min-w-0 flex-col gap-6" aria-labelledby="elsewhere-heading">
            <div class="rounded-[2rem] border border-line bg-surface p-6 sm:p-8">
                <h2 id="elsewhere-heading" class="text-2xl font-medium tracking-tight">
                    {t("contact.elsewhereTitle")}
                </h2>
                <ul class="mt-5 divide-y divide-line">
                    {links.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                target={link.external ? "_blank" : undefined}
                                rel={link.external ? "me noopener noreferrer" : undefined}
                                class="group flex min-h-14 items-center gap-4 py-3"
                            >
                                <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent-strong dark:text-accent">
                                    <Icon name={link.icon} />
                                </span>
                                <span class="min-w-0">
                                    <span class="block text-sm text-ink-muted">{link.label}</span>
                                    <span class="block truncate font-semibold group-hover:text-accent">
                                        {link.value}
                                    </span>
                                </span>
                                {link.external && (
                                    <span class="sr-only">{t("a11y.opensInNewTab")}</span>
                                )}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
            <a
                href={`${getPath("services", lang)}#quote`}
                class="group flex items-center justify-between gap-4 rounded-[2rem] bg-accent-soft p-6 font-semibold text-ink sm:p-8"
            >
                {t("contact.servicesLink")}
                <Icon
                    name="arrow-right"
                    class="size-5 shrink-0 text-accent-strong transition-transform group-hover:translate-x-1 dark:text-accent"
                />
            </a>
        </aside>
    </div>
</BaseLayout>
