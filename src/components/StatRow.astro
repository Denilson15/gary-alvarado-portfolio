---
interface Stat {
    value: string;
    label: string;
}

interface Props {
    stats: readonly Stat[];
    label: string;
}

const { stats, label } = Astro.props;
---

<section aria-label={label} class="border-y border-line">
    <dl class="grid grid-cols-2 lg:grid-cols-4">
        {stats.map((stat, index) => (
            <div
                class:list={[
                    "flex flex-col-reverse justify-end gap-2 px-1 py-8 sm:px-6",
                    index % 2 === 1 && "border-l border-line",
                    index >= 2 && "border-t border-line lg:border-t-0",
                    index === 2 && "lg:border-l",
                ]}
                data-reveal
                style={`--reveal-delay: ${index * 80}ms`}
            >
                <dt class="text-sm leading-snug text-ink-muted">{stat.label}</dt>
                <dd class="font-display text-5xl font-bold tracking-tight text-ink sm:text-6xl">
                    {stat.value}
                </dd>
            </div>
        ))}
    </dl>
</section>
