---
import { Image, getImage } from "astro:assets";
import type { Lang } from "@/i18n/config";
import { localized, useTranslations } from "@/i18n/utils";
import type { Project } from "@/lib/projects";
import Icon from "./Icon.astro";
import ProjectPreview from "./ProjectPreview.astro";
import TagList from "./TagList.astro";

/**
 * Large, editorial project row: big screenshot on one side, number, title and
 * problem → solution on the other. Alternate `reverse` between rows.
 */
interface Props {
    project: Project;
    lang: Lang;
    number: number;
    reverse?: boolean;
    headingLevel?: 2 | 3;
    eager?: boolean;
    /** Show the problem and solution blurb. */
    details?: boolean;
}

const {
    project,
    lang,
    number,
    reverse = false,
    headingLevel = 3,
    eager = false,
    details = true,
} = Astro.props;
const { data } = project;
const t = useTranslations(lang);
const Heading = headingLevel === 2 ? "h2" : "h3";
const newTab = t("a11y.opensInNewTab");
const primaryUrl = data.liveUrl ?? data.repoUrl;
const headingId = `project-${project.id}`;
const label = String(number).padStart(2, "0");
// A project with a `video` plays it in place of the screenshot; the image becomes its poster frame.
const poster =
    data.video && data.image
        ? (await getImage({ src: data.image, width: 1280, format: "webp" })).src
        : undefined;
const mediaClass =
    "h-full w-full object-cover object-top transition-transform duration-700 ease-out motion-safe:group-hover:scale-[1.03]";
---

<article
    class="group grid items-center gap-8 border-t border-line py-14 lg:grid-cols-12 lg:gap-14 lg:py-20"
    aria-labelledby={headingId}
    data-reveal
>
    <a
        href={primaryUrl}
        target="_blank"
        rel="noopener noreferrer"
        tabindex="-1"
        aria-hidden="true"
        class:list={[
            "relative block aspect-[16/10] overflow-hidden rounded-2xl border border-line bg-surface-muted lg:col-span-7",
            reverse && "lg:order-2",
        ]}
    >
        {data.video && poster ? (
            <video
                class={mediaClass}
                poster={poster}
                muted
                loop
                playsinline
                preload="none"
                disablepictureinpicture
                data-preview-video
            >
                <source src={data.video.mp4} type="video/mp4" />
                {data.video.webm && <source src={data.video.webm} type="video/webm" />}
            </video>
        ) : data.image ? (
            <Image
                src={data.image}
                alt=""
                widths={[560, 900, 1300]}
                sizes="(min-width: 1024px) 680px, 100vw"
                loading={eager ? "eager" : "lazy"}
                class={mediaClass}
            />
        ) : (
            <ProjectPreview title={data.title} hue={data.hue} />
        )}
    </a>

    <div class:list={["lg:col-span-5", reverse && "lg:order-1"]}>
        <div class="flex items-center gap-4">
            <span class="font-mono text-sm text-accent" aria-hidden="true">
                {label}
            </span>
            <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
            <span class="font-mono text-xs tracking-[0.14em] text-ink-muted uppercase">
                {t(`projects.status.${data.category}`)}
                {data.team && <> · {t("projects.teamProject")}</>}
                {data.year && <> · {data.year}</>}
            </span>
        </div>

        <Heading id={headingId} class="mt-6 text-3xl leading-tight sm:text-4xl">
            {data.title}
        </Heading>
        <p class="mt-4 text-lg leading-relaxed text-ink-muted">{localized(data.summary, lang)}</p>

        {details && (
            <dl class="mt-6 grid gap-4 border-l-2 border-accent/60 pl-5 text-sm leading-relaxed">
                <div>
                    <dt class="font-mono text-xs tracking-[0.14em] text-ink uppercase">
                        {t("projects.problem")}
                    </dt>
                    <dd class="mt-1 text-ink-muted">{localized(data.problem, lang)}</dd>
                </div>
                <div>
                    <dt class="font-mono text-xs tracking-[0.14em] text-ink uppercase">
                        {t("projects.solution")}
                    </dt>
                    <dd class="mt-1 text-ink-muted">{localized(data.solution, lang)}</dd>
                </div>
            </dl>
        )}

        <div class="mt-6">
            <TagList tags={data.tags} />
        </div>

        <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
            {data.liveUrl && (
                <a
                    href={data.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-accent-ink transition-colors hover:bg-accent-strong"
                >
                    {t("common.liveSite")}
                    <span class="sr-only">
                        : {data.title} {newTab}
                    </span>
                    <Icon name="arrow-up-right" class="size-4" />
                </a>
            )}
            {data.repoUrl && (
                <a
                    href={data.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-ink underline decoration-line underline-offset-8 transition-colors hover:text-accent hover:decoration-accent"
                >
                    <Icon name="github" class="size-4" />
                    {t("common.code")}
                    <span class="sr-only">
                        : {data.title} {newTab}
                    </span>
                </a>
            )}
        </div>
    </div>
</article>

<script>
    // Preview videos play only while on screen, and never for visitors who prefer reduced
    // motion (they see the poster frame). Nothing downloads until a video scrolls into view.
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const videos = document.querySelectorAll<HTMLVideoElement>("video[data-preview-video]");
    if (videos.length > 0 && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    const video = entry.target as HTMLVideoElement;
                    if (entry.isIntersecting && !reduceMotion.matches) {
                        video.muted = true;
                        video.play().catch(() => {});
                    } else {
                        video.pause();
                    }
                }
            },
            { threshold: 0.35 },
        );
        videos.forEach((video) => observer.observe(video));
        reduceMotion.addEventListener("change", () => {
            if (reduceMotion.matches) videos.forEach((video) => video.pause());
        });
    }
</script>
