---
/**
 * Stand-in artwork shown when a project has no screenshot yet. Dark, with a dotted
 * keypoint grid and the project title. Add an `image` to the project's JSON file to replace it.
 */
interface Props {
    title: string;
    hue: number;
}

const { title, hue } = Astro.props;
---

<div
    class="project-preview surface-dark relative flex h-full w-full items-end overflow-hidden p-6 sm:p-8"
    style={`--hue: ${hue}`}
    aria-hidden="true"
>
    <span class="relative max-w-[14ch] font-display text-3xl leading-[0.95] font-bold tracking-tight text-white/90 sm:text-5xl">
        {title}
    </span>
</div>

<style>
    .project-preview {
        background:
            radial-gradient(70% 90% at 85% 15%, hsl(var(--hue) 70% 50% / 0.35), transparent 65%),
            radial-gradient(
                60% 70% at 10% 100%,
                hsl(calc(var(--hue) + 40) 60% 45% / 0.25),
                transparent 60%
            ),
            #0d1114;
    }

    .project-preview::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(
            circle,
            hsl(var(--hue) 60% 80% / 0.35) 1px,
            transparent 1.5px
        );
        background-size: 22px 22px;
        mask-image: linear-gradient(160deg, black 10%, transparent 75%);
    }
</style>
