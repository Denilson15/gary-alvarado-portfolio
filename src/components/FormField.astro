---
import type { Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/utils";

interface Option {
    value: string;
    label: string;
}

interface Props {
    lang: Lang;
    /** Form name, used to keep ids unique when a page has more than one form. */
    form: string;
    name: string;
    label: string;
    type?: "text" | "email" | "url" | "textarea" | "select";
    required?: boolean;
    hint?: string;
    autocomplete?: string;
    options?: Option[];
    class?: string;
}

const {
    lang,
    form,
    name,
    label,
    type = "text",
    required = false,
    hint,
    autocomplete,
    options = [],
    class: className,
} = Astro.props;

const t = useTranslations(lang);
const id = `${form}-${name}`;
const hintId = hint ? `${id}-hint` : undefined;
const errorId = `${id}-error`;
const describedBy = [hintId, errorId].filter(Boolean).join(" ");
const control =
    "mt-2 block w-full rounded-xl border border-line bg-surface px-4 py-3 text-base text-ink placeholder:text-ink-muted transition-colors hover:border-ink-muted/60 focus:border-accent focus:outline-none focus-visible:outline-3 focus-visible:outline-offset-1 aria-[invalid=true]:border-red-600 dark:aria-[invalid=true]:border-red-400";
---

<div class={className} data-field>
    <label for={id} class="text-sm font-semibold text-ink">
        {label}
        {required ? (
            <span class="text-accent" aria-hidden="true">
                {" "}
                *
            </span>
        ) : (
            <span class="font-normal text-ink-muted"> ({t("form.optional")})</span>
        )}
    </label>
    {hint && (
        <p id={hintId} class="mt-1 text-sm text-ink-muted">
            {hint}
        </p>
    )}

    {type === "textarea" ? (
        <textarea
            id={id}
            name={name}
            rows="6"
            required={required}
            aria-describedby={describedBy}
            class:list={[control, "resize-y"]}
        />
    ) : type === "select" ? (
        <select
            id={id}
            name={name}
            required={required}
            aria-describedby={describedBy}
            class={control}
        >
            <option value="">{t("form.selectPlaceholder")}</option>
            {options.map((option) => (
                <option value={option.value}>{option.label}</option>
            ))}
        </select>
    ) : (
        <input
            id={id}
            name={name}
            type={type}
            required={required}
            autocomplete={autocomplete}
            aria-describedby={describedBy}
            class={control}
        />
    )}
    <p id={errorId} class="mt-1.5 text-sm font-medium text-red-700 dark:text-red-300" hidden></p>
</div>
