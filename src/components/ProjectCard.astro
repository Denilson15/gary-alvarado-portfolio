---
import { Image } from "astro:assets";
import type { Lang } from "@/i18n/config";
import { localized, useTranslations } from "@/i18n/utils";
import type { Project } from "@/lib/projects";
import Icon from "./Icon.astro";
import ProjectPreview from "./ProjectPreview.astro";
import TagList from "./TagList.astro";

interface Props {
    project: Project;
    lang: Lang;
    /** wide: image beside text on large screens · standard: image on top · compact: no image */
    variant?: "wide" | "standard" | "compact";
    headingLevel?: 2 | 3;
    /** Show the problem and solution blurb. */
    details?: boolean;
    /** Load the image eagerly when the card is above the fold. */
    eager?: boolean;
}

const {
    project,
    lang,
    variant = "standard",
    headingLevel = 3,
    details = variant !== "compact",
    eager = false,
} = Astro.props;
const { data } = project;
const t = useTranslations(lang);
const Heading = headingLevel === 2 ? "h2" : "h3";
const newTab = t("a11y.opensInNewTab");
const headingId = `project-${project.id}`;
---

<article
    class:list={[
        "group flex flex-col overflow-hidden rounded-3xl border border-line bg-surface transition-[border-color,box-shadow,transform] duration-300 hover:border-accent/50 hover:shadow-xl hover:shadow-black/5 motion-safe:hover:-translate-y-1 dark:hover:shadow-black/30",
        variant === "wide" && "lg:col-span-2 lg:grid lg:grid-cols-[1.15fr_1fr]",
    ]}
    aria-labelledby={headingId}
    data-reveal
>
    {variant !== "compact" && (
        <div
            class:list={[
                "relative aspect-[16/10] overflow-hidden border-b border-line bg-surface-muted",
                variant === "wide" &&
                    "lg:order-2 lg:aspect-auto lg:min-h-full lg:border-b-0 lg:border-l",
            ]}
        >
            {data.image ? (
                <Image
                    src={data.image}
                    alt={t("projects.screenshotAlt", { title: data.title })}
                    widths={[480, 800, 1200]}
                    sizes={
                        variant === "wide"
                            ? "(min-width: 1024px) 560px, 100vw"
                            : "(min-width: 1024px) 520px, 100vw"
                    }
                    loading={eager ? "eager" : "lazy"}
                    class="h-full w-full object-cover object-top transition-transform duration-500 motion-safe:group-hover:scale-[1.02]"
                />
            ) : (
                <ProjectPreview title={data.title} hue={data.hue} />
            )}
        </div>
    )}

    <div class="flex flex-1 flex-col gap-5 p-6 sm:p-7">
        <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
            <span
                class:list={[
                    "inline-flex items-center gap-1.5 rounded-full px-2.5 py-1",
                    data.category === "in-progress"
                        ? "bg-warn-bg text-warn-ink"
                        : "bg-accent-soft text-accent-strong dark:text-accent",
                ]}
            >
                {(data.category === "live" || data.category === "client") && (
                    <span class="size-1.5 rounded-full bg-current" aria-hidden="true" />
                )}
                {t(`projects.status.${data.category}`)}
            </span>
            {data.team && (
                <span class="rounded-full border border-line px-2.5 py-1 text-ink-muted">
                    {t("projects.teamProject")}
                </span>
            )}
        </div>

        <div>
            <Heading id={headingId} class="text-2xl font-medium tracking-tight">
                {data.title}
            </Heading>
            <p class="mt-2 leading-relaxed text-ink-muted">{localized(data.summary, lang)}</p>
        </div>

        {details && (
            <dl class="grid gap-3 text-sm leading-relaxed">
                <div>
                    <dt class="font-semibold text-ink">{t("projects.problem")}</dt>
                    <dd class="text-ink-muted">{localized(data.problem, lang)}</dd>
                </div>
                <div>
                    <dt class="font-semibold text-ink">{t("projects.solution")}</dt>
                    <dd class="text-ink-muted">{localized(data.solution, lang)}</dd>
                </div>
            </dl>
        )}

        <div class="mt-auto flex flex-col gap-5">
            <TagList tags={data.tags} />
            <div class="flex flex-wrap gap-2">
                {data.liveUrl && (
                    <a
                        href={data.liveUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-h-11 items-center gap-2 rounded-full bg-accent px-4 py-2 text-sm font-semibold text-accent-ink transition-colors hover:bg-accent-strong"
                    >
                        {t("common.liveSite")}
                        <span class="sr-only">
                            : {data.title} {newTab}
                        </span>
                        <Icon name="arrow-up-right" class="size-4" />
                    </a>
                )}
                {data.repoUrl && (
                    <a
                        href={data.repoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-h-11 items-center gap-2 rounded-full border border-line px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-accent hover:text-accent"
                    >
                        <Icon name="github" class="size-4" />
                        {t("common.code")}
                        <span class="sr-only">
                            : {data.title} {newTab}
                        </span>
                    </a>
                )}
            </div>
        </div>
    </div>
</article>
