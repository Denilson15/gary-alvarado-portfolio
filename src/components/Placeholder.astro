---
/**
 * A clearly marked box for content Gary still needs to write.
 * Search the project for "PLACEHOLDER" to find every one.
 */
interface Props {
    label: string;
    class?: string;
}

const { label, class: className } = Astro.props;
---

<div
    class:list={[
        "rounded-2xl border-2 border-dashed border-warn-line bg-warn-bg p-5 text-warn-ink",
        className,
    ]}
    data-placeholder
>
    <p class="text-xs font-bold tracking-[0.12em] uppercase">{label}</p>
    <div class="mt-2 text-sm leading-relaxed">
        <slot />
    </div>
</div>
