---
interface Props {
    title: string;
    lead?: string;
    eyebrow?: string;
    id?: string;
    level?: 1 | 2;
    class?: string;
}

const { title, lead, eyebrow, id, level = 2, class: className } = Astro.props;
const Heading = level === 1 ? "h1" : "h2";
---

<div class:list={["max-w-3xl", className]} data-reveal>
    {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
    <Heading
        id={id}
        class:list={[
            "font-medium tracking-tight",
            level === 1 ? "text-4xl sm:text-5xl lg:text-6xl" : "text-3xl sm:text-4xl",
        ]}
    >
        {title}
    </Heading>
    {lead && <p class="mt-4 text-lg leading-relaxed text-ink-muted">{lead}</p>}
</div>
