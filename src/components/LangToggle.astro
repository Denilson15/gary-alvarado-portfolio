---
import type { Lang } from "@/i18n/config";
import { getPath, type RouteId } from "@/i18n/routes";
import { useTranslations } from "@/i18n/utils";

interface Props {
    lang: Lang;
    routeId: RouteId;
}

const { lang, routeId } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === "en" ? "es" : "en";
---

<a
    href={getPath(routeId, otherLang)}
    hreflang={otherLang}
    lang={otherLang}
    aria-label={`${t("language.switchShort")}: ${t("language.switchLabel")}`}
    title={t("language.switchLabel")}
    class="inline-flex h-11 min-w-11 items-center justify-center rounded-full border border-line px-3 text-sm font-semibold text-ink transition-colors hover:border-accent hover:text-accent"
    data-lang-toggle
>
    {t("language.switchShort")}
</a>
